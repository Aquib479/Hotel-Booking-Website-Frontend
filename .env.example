# Local Nest API (when running apps/api on port 3001):
# VITE_API_BASE_URL=http://localhost:3001

# Deployed API Gateway (RestHalf / existing backend):
VITE_API_BASE_URL=https://oxwb0croja.execute-api.ap-southeast-1.amazonaws.com

# --- ZentrumHub Booking Engine (fill these to enable live hotel search/book) ---
# Copy this file to `.env.local` and paste credentials from your ZentrumHub account.
VITE_ZENTRUMHUB_API_KEY=
VITE_ZENTRUMHUB_ACCOUNT_ID=
VITE_ZENTRUMHUB_CHANNEL_ID=

# Optional overrides
# VITE_ZENTRUMHUB_CURRENCY=USD
# VITE_ZENTRUMHUB_CULTURE=en-US
# In production builds, you may need absolute URLs if you don't proxy at the CDN:
# VITE_ZENTRUMHUB_NEXUS_URL=https://nexus.prod.zentrumhub.com
# VITE_ZENTRUMHUB_AUTOSUGGEST_URL=https://autosuggest.travel.zentrumhub.com
